#include <iostream>
using namespace std;

void reverseArray(int arr[], int n) {
    int i = 0;
    int j = n - 1;

    while (i < j) {
        int t = arr[i];
        arr[i] = arr[j];
        arr[j] = t;

        i++;
        j--;
    }
}

int main() {
    int arr[6];
    int n = 6;

    cout << "Enter 6 number of elements:\n";
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }
    for (int i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }
    cout << endl;

    reverseArray(arr, n);
    for (int i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }

    return 0;
}
