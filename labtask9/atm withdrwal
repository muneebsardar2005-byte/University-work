#include <iostream>
using namespace std;

void attemptWithdraw(int balance, int amount) {
    cout << "Attempting withdrawal…" << endl;

    if(amount <= balance) 
    {
        balance = balance - amount; 
        cout << "Withdrawal successful. New balance inside function: "
             << balance << endl;
    } 
    else 
    {
        cout << "Withdrawal failed. Not enough balance." << endl;
    }
}

int main() 
{
    int balance = 5000;
    int amount = 1200;

    attemptWithdraw(balance, amount);

    cout << "Balance in main: " << balance << endl;

    return 0;
}
